DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mailer
DB_USER=mailer
DB_PASS=mailer
DB_SSL=false
# Optional trusted CA file for a remote MySQL TLS connection.
DB_SSL_CA=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
# Service account JSON / Application Default Credentials for Sheets + Drive.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SPREADSHEET_ID=
SHEET_NAME=Outreach
TEMPLATE_SHEET_NAME="Template Library"
# No outgoing Gmail API requests unless explicitly enabled.
SEND_ENABLED=false
POLL_INTERVAL_MS=60000
# A cron batch exits when it finishes eligible work, reaches this cap, or runs out of time.
CRON_MAX_MESSAGES=50
CRON_MAX_RUNTIME_SECONDS=1800
# Persistent mode schedules these local hours, independently of the host timezone.
CRON_TIMEZONE=Asia/Kolkata
CRON_HOURS=10,18
# Set the public HTTPS URL before enabling pixels in newly prepared messages.
TRACKING_ENABLED=false
TRACKING_BASE_URL=
TRACKING_HOST=127.0.0.1
TRACKING_PORT=3001
FOLLOWUP_DAYS=2
MAX_FOLLOWUPS=3
SEND_TIMEZONE=Asia/Kolkata
SEND_HOUR_START=9
SEND_HOUR_END=19
DAILY_SEND_LIMIT=50
HOURLY_SEND_LIMIT=15
MIN_SEND_GAP_SECONDS=120
STALE_FOLLOWUP_DAYS=7
# Exact HTTPS hosts permitted for non-Drive cloud attachment URLs; comma-separated.
# Example: my-bucket.s3.ap-south-1.amazonaws.com,files.example.com
ATTACHMENT_ALLOWED_HOSTS=
